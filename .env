# LOCAL DEVELOPMENT PLACEHOLDERS ONLY. This file is ignored by Git.
# Replace local secrets before running; never use these values in production.
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow
JWT_SECRET=development_only_replace_this_secret_before_use_123456
JWT_EXPIRES_IN=15m
COOKIE_SECRET=development_only_replace_this_cookie_secret_123456
EMAIL_PROVIDER=disabled
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
UPLOAD_PROVIDER=local
UPLOAD_DIRECTORY=uploads
MAX_FILE_SIZE_MB=5
